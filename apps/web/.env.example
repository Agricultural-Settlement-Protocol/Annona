# Annona web env. Copy to .env.local. Public vars are exposed to the browser.

NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# DEPLOY HANDOFF: after `bash scripts/deploy.sh`, copy `registryId` from
# scripts/artifacts.testnet.json here. Until set, the KMP write path runs in
# DEMO MODE (simulated signing) so the dashboard is walkable pre-deploy.
NEXT_PUBLIC_OFFTAKE_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_DIDR_TOKEN_CONTRACT_ID=
NEXT_PUBLIC_API_URL=http://localhost:8787

# Supabase (auth + data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq AI (oversight assistant). Server-side only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
