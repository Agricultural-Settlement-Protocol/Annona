# Annona API env. Copy to .env. NEVER commit real keys. Testnet only.

PORT=8787

# Stellar
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
OFFTAKE_REGISTRY_CONTRACT_ID=
DIDR_TOKEN_CONTRACT_ID=
# service key used to submit Path-A settle() calls (testnet secret seed, S...)
SETTLEMENT_SERVICE_SECRET=

# Database (Supabase / Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/annona

# AI assistant (optional, cuttable)
GEMINI_API_KEY=
