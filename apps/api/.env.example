# Local dev env (Docker compose postgres). NOT committed. Testnet only.
PORT=8787

# Stellar (unused until deploy; indexer not started by `dev`)
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
OFFTAKE_REGISTRY_CONTRACT_ID=CC5NZIW5OYPYQYQOW2T6GAYDBLHBBZHG6BHYCQQH3FPM5OZEC7WJCQHQ
DIDR_TOKEN_CONTRACT_ID=CAJKD7II6HCCVA57F2ERVCEQR33TIDKNXSK5FY4FDORUJ2NY62BCG4SX
# Server-side signer for settle() (no Freighter). Dev value: `stellar keys
# secret annona-coop` — this IS the coop's own key, not a separate admin.
# PRODUCTION: read from a secrets manager, never a plaintext value.
SETTLEMENT_SERVICE_SECRET=

# Database (local docker-compose postgres:16-alpine, no pooler)
DATABASE_URL=postgresql://annona:annona@localhost:5432/annona
DIRECT_URL=postgresql://annona:annona@localhost:5432/annona

# Supabase (auth gate only — verifies the caller's bearer token + app_user
# role for POST /settlements/execute; same project as apps/web).
SUPABASE_URL=
SUPABASE_ANON_KEY=

GEMINI_API_KEY=

# Comma-separated list of origins allowed by CORS. Defaults to localhost:3000
# for local dev. Production: set to the deployed web app's real origin(s).
ALLOWED_ORIGINS=http://localhost:3000