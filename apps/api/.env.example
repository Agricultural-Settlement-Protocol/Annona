# Annona API env. Copy to .env. NEVER commit real keys. Testnet only.

PORT=8787

# Stellar
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
OFFTAKE_REGISTRY_CONTRACT_ID=
DIDR_TOKEN_CONTRACT_ID=
# service key used to submit Path-A settle() calls (testnet secret seed, S...)
SETTLEMENT_SERVICE_SECRET=

# Database (Supabase project: ldjrsjyecihvynturgnr)
# Get both URLs from: Dashboard -> Connect -> ORMs (or Connection String).
# Runtime = transaction pooler (6543); requires prepare:false (set in db/client.ts).
DATABASE_URL=postgresql://postgres.ldjrsjyecihvynturgnr:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# Migrations / drizzle-kit = session pooler (5432).
DIRECT_URL=postgresql://postgres.ldjrsjyecihvynturgnr:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# AI assistant (optional, cuttable)
GEMINI_API_KEY=
