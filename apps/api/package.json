  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "biome lint src",
    "check-types": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
