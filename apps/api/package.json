    "hono": "^4.6.14",
    "postgres": "^3.4.9",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@annona/config": "workspace:*",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
